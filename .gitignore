# Project-specific
# NOTE: DNABERT-2-117M/ is committed (modified source for newer-PyTorch
# compatibility); pytorch_model.bin is excluded by the *.bin rule above
# and must be fetched via scripts/download_dnabert_weights.sh
/DNABERT-2-117M/.cache/
/checkpoints/

# Staging notes for the Zenodo v2 upload. Working files only — they stop being
# useful once the record is published.
/docs/zenodo/

# Per-analysis READMEs are development notes, not public documentation.
# They stay on disk; the top-level README carries what readers need.
/analyses/*/README.md

# Evolving LUAD interpretation notes, retained locally between analysis stages.
/analyses/luad_analysis/interpretations.md

# data/ holds 6.3 GB, of which ~3 MB is worth versioning. The rule is: commit
# what code reads and nothing can regenerate; ignore what a download or a
# documented command reproduces. Ignore whole directories rather than listing
# files, so new outputs land ignored by default.
#
# NOTE: gitignore has no trailing-comment syntax. A pattern line is taken
# literally to end-of-line, so `/data/foo/  # why` matches nothing. Keep
# comments on their own lines.

# Benchmark splits — 1.9 GB, fetched by scripts/download_data.sh from Zenodo.
/data/datasets/

# Third-party reference DBs — 4.2 GB of Pfam, including a 2.0 GB Pfam-A.hmm
# that exceeds GitHub's 100 MB per-file limit. Fetched manually; see README.
/data/external/

# CORAL inference outputs — 99 MB, regenerated by scripts/predict.py.
/data/predictions/

# Derived FASTA — regenerated by RBD_analysis notebook 02.
/data/sequences/

# Cohort source matrices and derived LUAD analysis inputs are reproducible.
/data/TCGA/

# PDB structures — 233 MB of coordinate files, fetched from RCSB. The contact
# annotations alongside them are small and stay committed.
/data/pdb/single_pairs_pdb_files/

# hmmscan outputs — 16 MB, regenerated by RBD_analysis/scripts/run_hmmscan.sh.
/data/rbd/*.domtbl
/data/rbd/*.hmmscan.txt

# Historical LUAD bulk artifacts and frozen result snapshots.
/analyses/luad_analysis/archived_results/

/analyses/luad_analysis/data/

# Generated LUAD analysis inputs and outputs.
/analyses/luad_analysis/config/
/analyses/luad_analysis/figures/
/analyses/luad_analysis/run_manifests/
/analyses/luad_analysis/tables/

# Local LUAD training-exposure analysis scripts.
/analyses/luad_analysis/scripts/_training_exposure.py
/analyses/luad_analysis/scripts/audit_training_exposure.py
/analyses/luad_analysis/scripts/summarize_score_distributions.py
