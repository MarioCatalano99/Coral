__pycache__/
*.py[cod]
*$py.class
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Packaging
*.egg
*.egg-info/
build/
dist/
.eggs/
pip-wheel-metadata/
pip-log.txt

# Virtual environments
.env
.venv
env/
venv/
ENV/

# Jupyter / IPython
.ipynb_checkpoints/
.python-version

# Editor / OS
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Experiment artefacts
wandb/
runs/
results/
logs/
*.log

# Large binaries that should not live in git
*.safetensors
*.bin
*.pt
*.pth
*.ckpt
*.npz
*.npy
*.h5
*.hdf5

# Project-specific
# NOTE: DNABERT-2-117M/ is committed (modified source for newer-PyTorch
# compatibility); pytorch_model.bin is excluded by the *.bin rule above
# and must be fetched via scripts/download_dnabert_weights.sh
/DNABERT-2-117M/.cache/
/checkpoints/

# Staging notes for the Zenodo v2 upload. Working files only — they stop being
# useful once the record is published.
/docs/zenodo/

# Local reference copies of the paper (preprint and final NAR PDFs). Not
# redistributed with the code.
/docs/local/

# data/ holds ~4 GB locally, of which ~6 MB is worth versioning. The rule is:
# commit what code reads and nothing can regenerate; ignore what a download or
# a documented command reproduces. Ignore whole directories rather than listing
# files, so new outputs land ignored by default.
#
# NOTE: gitignore has no trailing-comment syntax. A pattern line is taken
# literally to end-of-line, so `/data/foo/  # why` matches nothing. Keep
# comments on their own lines.

# Benchmark splits — 1.2 GB, fetched by scripts/download_data.sh from Zenodo.
/data/datasets/
# Local copy of the splits with uniformly sampled negatives (Zenodo data v1).
/data/datasets_uniform_v1/

# Third-party reference DBs — 4.2 GB of Pfam, including a 2.0 GB Pfam-A.hmm
# that exceeds GitHub's 100 MB per-file limit. Fetched manually; see README.
/data/external/

# CORAL inference outputs, regenerated by scripts/predict.py and
# analyses/RBD_analysis/run.sh.
/data/predictions/

# Derived FASTA, regenerated by analyses/RBD_analysis/run.sh.
/data/sequences/

# TCGA LUAD sources and the inputs and predictions derived from them, rebuilt by
# analyses/luad_analysis/scripts/inputs/.
/data/luad/

# LUAD stage analysis: code, config.json, tests, README and the nine result
# tables (~10 KB) are versioned. The per-patient, ranking and null-distribution
# tables beside them in tables/ (~14 MB) and the figures are regenerated by the
# steps. tables/ is ignored as a whole, so new outputs land ignored by default;
# the result tables are listed back in.
/analyses/luad_analysis/figures/
/analyses/luad_analysis/tables/*
!/analyses/luad_analysis/tables/cohort_summary.tsv
!/analyses/luad_analysis/tables/panel_summary.tsv
!/analyses/luad_analysis/tables/overlap.tsv
!/analyses/luad_analysis/tables/margin_correlation.tsv
!/analyses/luad_analysis/tables/stage_association.tsv
!/analyses/luad_analysis/tables/tnm_association.tsv
!/analyses/luad_analysis/tables/dependence.tsv
!/analyses/luad_analysis/tables/dependence_stage_counts.tsv
!/analyses/luad_analysis/tables/composition.tsv

# RBD analysis: results/ (covered by the rule above) is regenerated by run.sh.
# The PUA deep dive is a local follow-up of that run and is not published.
/analyses/RBD_analysis/PUA_deep_dive/
