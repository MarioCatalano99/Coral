# Byte-compiled / cached
__pycache__/
*.py[cod]
*$py.class
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Packaging
*.egg
*.egg-info/
build/
dist/
.eggs/
pip-wheel-metadata/
pip-log.txt

# Virtual environments
.env
.venv
env/
venv/
ENV/

# Jupyter / IPython
.ipynb_checkpoints/
.python-version

# Editor / OS
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Experiment artefacts
wandb/
runs/
results/
logs/
*.log

# Large binaries that should not live in git
*.safetensors
*.bin
*.pt
*.pth
*.ckpt
*.npz
*.npy
*.h5
*.hdf5

# Project-specific
# NOTE: DNABERT-2-117M/ is committed (modified source for newer-PyTorch
# compatibility); pytorch_model.bin is excluded by the *.bin rule above
# and must be fetched via scripts/download_dnabert_weights.sh
/DNABERT-2-117M/.cache/
/checkpoints/

# Staging notes for the Zenodo v2 upload. Working files only — they stop being
# useful once the record is published.
/docs/zenodo/

# Per-analysis READMEs are development notes, not public documentation.
# They stay on disk; the top-level README carries what readers need.
/analyses/*/README.md

# data/ is ignored wholesale for now — 6.3 GB of splits, Pfam, PDB structures,
# predictions and derived FASTA, all either fetched or regenerable. Which
# subsets are worth committing is still to be decided; until then nothing new
# under data/ enters the index.
#
# NOTE: gitignore has no trailing-comment syntax. A pattern line is taken
# literally to end-of-line, so `/data/foo/  # why` matches nothing. Keep
# comments on their own lines.
/data/
